    },
    "attack": {
      "title": "Attack and wheel",
      "text": "If you stand on a tile with another figure, you can attack. The wheel of fortune decides: a hit costs 1 life, a shield blocks it."
    },
    "board": {
      "title": "Change the board",
      "text": "The board grows and shrinks with you. New tiles open escape routes, removed tiles split enemies apart – it always stays connected. You paint your own textures when adding tiles."
    },
    "rules": {
      "title": "Invent rules",
      "text": "With “New rule” you build rules from blocks or write them as text: IF something happens, AND conditions hold, THEN effects happen. Rules apply to everyone alike and only take effect from the next round."
    },
    "workshop": {
      "title": "Effect workshop",
      "text": "The library leads to the workshop: build your own effects from blocks or pro code, draw NPC types and record sounds. Everything can be shared as a rule package."
    },
    "keys": {
      "title": "Shortcuts",
      "text": "Arrow keys move, 1–5 choose actions, R folds the rules in and out, space spins the wheel. Have fun!"
